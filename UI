        click.MouseButton1Down:Connect(function() overlay.Visible = true end)
        click.MouseButton1Up:Connect(function() overlay.Visible = false end)
        click.MouseLeave:Connect(function() overlay.Visible = false end)
        if o.OnClick then click.Activated:Connect(o.OnClick) end
