    local function readCustomStickers()
        if not (readfile and isfile) then return end
        pcall(function()
            if isfile("YinYang_CustomStickers.json") then
                local data = HttpService:JSONDecode(readfile("YinYang_CustomStickers.json"))
                if type(data) == "table" then customStickers = data end
            end
        end)
    end
    local function saveCustomStickers()
        if not writefile then return end
        pcall(function() writefile("YinYang_CustomStickers.json", HttpService:JSONEncode(customStickers)) end)
    end
