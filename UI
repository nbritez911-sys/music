    function FS.BuildUI(Window, Main)
        local Z = 230 -- por debajo de la hoja premium del Estudio de Logos (280+), así se puede abrir encima
        local K = { Z = Z, refreshers = {}, ED = { G = {}, O = {}, scope = nil }, conns = {}, samples = {} }
        FS.UIKit(K)

        function K.isPress(input)
            return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
        end
        function K.getRaw(key)
            local ED = K.ED
            if ED.scope then
                local o = ED.O[ED.scope]
                return o and o[key]
            end
            return ED.G[key]
        end
        function K.setRaw(key, raw)
            local ED = K.ED
            if ED.scope then
                local o = ED.O[ED.scope] or {}
                o[key] = raw
                if next(o) == nil then ED.O[ED.scope] = nil else ED.O[ED.scope] = o end
            else
                ED.G[key] = raw
            end
        end
        function K.get(key)
            local ED = K.ED
            local v = ED.G[key]
            if ED.scope then
                local o = ED.O[ED.scope]
                if o and o[key] ~= nil then v = o[key] end
            end
            if v == "_orig" then return nil end
            return v
        end
