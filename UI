    -- ============ ventana ============
    -- o = {Name, DisplayOrder, IgnoreGuiInset, Width, Height (nil = alto automático), Position, AnchorPoint, MinSize, MaxSize,
    --      Title, Subtitle, Info (línea extra), Avatar (UserId), Badge (true = chip de nivel), Count (true = chip contador),
    --      Minimize, Close, Lock (Locked = empieza fijada), Modal (fondo oscuro y centrada), Scroll, HeaderHeight, OnClose, Flash, Gap, Pad}
    function Kit.Window(o)
        o = o or {}
        local W = {Closed = false}
        local gui = Kit.Screen(o.Name or "YYWindow", o.DisplayOrder or 50, o.Parent)
        gui.IgnoreGuiInset = o.IgnoreGuiInset == true
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        W.Gui = gui
        if o.Flash then
            W.Flash = Kit.New("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(200, 0, 0), BackgroundTransparency = 1,
                BorderSizePixel = 0, Active = false, ZIndex = 0}, gui)
        end
        local parent = gui
        if o.Modal then
            W.Shade = Kit.New("TextButton", {Name = "Shade", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
                BackgroundTransparency = 1, Text = "", AutoButtonColor = false}, gui)
            W.Shade.Activated:Connect(function() W:Close() end)
            parent = W.Shade
        end
        local auto = o.Height == nil
        local frame = Kit.New(o.Modal and "TextButton" or "Frame", {Name = "Window", AnchorPoint = o.AnchorPoint or (o.Modal and Vector2.new(0.5, 0.5) or Vector2.new(0, 0)),
            Position = o.Position or (o.Modal and UDim2.fromScale(0.5, 0.5) or UDim2.fromOffset(16, 110)),
            Size = typeof(o.Width) == "UDim2" and o.Width or UDim2.new(0, o.Width or 300, typeof(o.Height) == "UDim" and o.Height.Scale or 0,
                typeof(o.Height) == "UDim" and o.Height.Offset or (o.Height or 0)),
            AutomaticSize = auto and Enum.AutomaticSize.Y or Enum.AutomaticSize.None, BackgroundTransparency = o.Transparency or 0.04,
            BorderSizePixel = 0, Active = true, ClipsDescendants = not auto}, parent, {bg = "Background"})
        if o.Modal then frame.Text = "" frame.AutoButtonColor = false end
        Kit.Corner(frame, o.Radius or 18)
        Kit.Stroke(frame, o.Modal and "Stroke" or "Accent", 1.5, o.Modal and 0.55 or 0.4)
        if o.MinSize or o.MaxSize then
            Kit.New("UISizeConstraint", {MinSize = o.MinSize or Vector2.new(0, 0), MaxSize = o.MaxSize or Vector2.new(math.huge, math.huge)}, frame)
        end
        W.Frame = frame
        W.Scale = Kit.New("UIScale", {Scale = 0.9}, frame)

        -- cabecera
        local headH = o.HeaderHeight or ((o.Avatar or o.Subtitle) and 52 or 40)
        local head = Btn(frame, {Name = "Header", Size = UDim2.new(1, 0, 0, headH), BackgroundTransparency = o.HeaderTransparency or 0.15, Text = ""},
            o.FlatHeader and "Background" or "Secondary", "Text")
        if o.FlatHeader then head.BackgroundTransparency = 1 end
        Kit.Corner(head, o.Radius or 18)
        if not o.FlatHeader then
            -- tapa las esquinas de abajo de la cabecera
            Kit.New("Frame", {Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 1, -16), BorderSizePixel = 0,
                BackgroundTransparency = o.HeaderTransparency or 0.15}, head, {bg = "Secondary"})
        end
        W.Header = head
        local x = 14
        if o.Avatar then
            local av = Kit.New("ImageLabel", {Position = UDim2.new(0, 12, 0.5, -20), Size = UDim2.fromOffset(40, 40), BorderSizePixel = 0,
                Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(o.Avatar) .. "&w=150&h=150"}, head, {bg = "Secondary"})
            Kit.Corner(av, 20)
            Kit.Stroke(av, "Accent", 2, 0.2)
            x = 60
        end
        local right = 12
        local function headButton(text)
            local b = Btn(head, {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -right, 0.5, 0), Size = UDim2.fromOffset(28, 28),
                TextSize = 14, Text = text}, "Background", "Text")
            Kit.Corner(b, 14)
            right = right + 34
            return b
        end
        if o.Close ~= false then
            W.CloseButton = headButton("X")
            W.CloseButton.Activated:Connect(function() W:Close() end)
        end
        if o.Minimize then
            W.MinButton = headButton("-")
            W.MinButton.Activated:Connect(function() W:SetMinimized(not W.Minimized) end)
        end
        if o.Lock then
            W.LockButton = headButton("📌")
            W.Locked = o.Locked == true
            W.LockButton.BackgroundTransparency = W.Locked and 0 or 0.6
            W.LockButton.Activated:Connect(function()
                W.Locked = not W.Locked
                W.LockButton.BackgroundTransparency = W.Locked and 0 or 0.6
                if o.OnLock then o.OnLock(W.Locked) end
            end)
        end
        if o.Count then
            W.CountChip = Kit.New("TextLabel", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -right, 0.5, 0), Size = UDim2.fromOffset(44, 22),
                BorderSizePixel = 0, Font = Enum.Font.GothamBold, TextSize = 12, Text = "0"}, head, {bg = "Accent", text = "AccentText"})
            Kit.Corner(W.CountChip, 11)
            right = right + 50
        end
        if o.Badge then
            W.BadgeChip = Kit.New("TextLabel", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -right, 0.5, 0), Size = UDim2.fromOffset(62, 24),
                BorderSizePixel = 0, Font = Enum.Font.GothamBlack, TextSize = 12, Text = ""}, head, {bg = "Accent", text = "AccentText"})
            Kit.Corner(W.BadgeChip, 12)
            right = right + 68
        end
        local titleH = (o.Subtitle or o.Info) and 20 or headH
        W.TitleLabel = Label(head, {Position = UDim2.fromOffset(x, (o.Subtitle or o.Info) and 6 or 0), Size = UDim2.new(1, -x - right, 0, titleH),
            Font = Enum.Font.GothamBlack, TextSize = o.TitleSize or 15, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
            Text = o.Title or ""}, "Text")
        if o.Subtitle then
            W.SubtitleLabel = Label(head, {Position = UDim2.fromOffset(x, 26), Size = UDim2.new(1, -x - right, 0, 14), Font = Enum.Font.GothamMedium,
                TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = o.Subtitle}, "TextDim")
        end
        if o.Info then
            W.InfoLabel = Label(head, {Position = UDim2.fromOffset(x, o.Subtitle and 40 or 26), Size = UDim2.new(1, -x - 16, 0, 14), TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left, RichText = true, Text = ""}, "Text")
        end
        if o.Drag ~= false and not o.Modal then dragFrom(head, frame, function() return W.Locked end) end

        -- cuerpo
        local body
        local pad = o.Pad or 12
        if o.Scroll then
            body = Kit.New("ScrollingFrame", {Position = UDim2.fromOffset(0, headH), Size = UDim2.new(1, 0, 1, -headH), BackgroundTransparency = 1,
                BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = Kit.Palette().Accent, CanvasSize = UDim2.new(),
                AutomaticCanvasSize = Enum.AutomaticSize.Y}, frame)
        else
            body = Kit.New("Frame", {Position = UDim2.fromOffset(0, headH), Size = UDim2.new(1, 0, auto and 0 or 1, auto and 0 or -headH),
                AutomaticSize = auto and Enum.AutomaticSize.Y or Enum.AutomaticSize.None, BackgroundTransparency = 1, ClipsDescendants = o.Clip == true}, frame)
        end
        if not o.Raw then
            Kit.Pad(body, o.PadTop or 10, pad, pad, pad)
            Kit.List(body, o.Gap or 8)
        end
        if auto then
            -- alto automático: cabecera + cuerpo
            local filler = Kit.New("Frame", {Size = UDim2.new(1, 0, 0, headH), BackgroundTransparency = 1}, frame)
            filler.Name = "HeaderSpace"
            frame.AutomaticSize = Enum.AutomaticSize.Y
            body.Position = UDim2.fromOffset(0, headH)
            -- un layout para apilar el espacio de la cabecera y el cuerpo
            Kit.New("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, frame)
            head.Parent = filler
            head.Position = UDim2.new()
            filler.LayoutOrder, body.LayoutOrder = 1, 2
        end
        W.Body = body
        setmetatable(W, {__index = function(t, k)
            local f = Widgets[k]
            if f then return function(self, ...) return f(t._widgets, ...) end end
            return nil
        end})
        W._widgets = container(body, o.Gap or 8)
        function W:SetTitle(t) W.TitleLabel.Text = t end
        function W:SetSubtitle(t) if W.SubtitleLabel then W.SubtitleLabel.Text = t end end
        function W:SetInfo(t) if W.InfoLabel then W.InfoLabel.Text = t end end
        function W:SetBadge(t) if W.BadgeChip then W.BadgeChip.Text = t end end
        function W:SetCount(t) if W.CountChip then W.CountChip.Text = t end end
        -- piezas que no se esconden al minimizar (van arriba del cuerpo)
        function W:Pinned()
            if not W._pinned then
                local top = Kit.New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 0},
                    auto and frame or body)
                if auto then
                    top.LayoutOrder = 2
                    body.LayoutOrder = 3
                    Kit.Pad(top, 8, pad, 0, pad)
                end
                Kit.List(top, o.Gap or 8)
                W._pinned = container(top, o.Gap or 8)
            end
            return W._pinned
        end
        function W:SetMinimized(m)
            W.Minimized = m
            body.Visible = not m
            if W.MinButton then W.MinButton.Text = m and "+" or "-" end
            if not auto then
                frame.Size = m and UDim2.new(frame.Size.X.Scale, frame.Size.X.Offset, 0, headH) or W._fullSize
            end
        end
        W._fullSize = frame.Size
        function W:Show()
            gui.Enabled = true
            W.Scale.Scale = 0.9
            Kit.Tween(W.Scale, 0.3, {Scale = 1}, Enum.EasingStyle.Back)
            if W.Shade then Kit.Tween(W.Shade, 0.25, {BackgroundTransparency = 0.45}) end
        end
        function W:Hide() gui.Enabled = false end
        function W:Close()
            if W.Closed then return end
            if o.OnClose then
                local keep = o.OnClose()
                if keep == true then return end
            end
            W:Destroy()
        end
        function W:Destroy()
            if W.Closed then return end
            W.Closed = true
            if W.Shade then
                Kit.Tween(W.Shade, 0.2, {BackgroundTransparency = 1})
                local tw = Kit.Tween(W.Scale, 0.2, {Scale = 0.88}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                tw.Completed:Wait()
            end
            if gui.Parent then gui:Destroy() end
        end
        W:Show()
        return W
    end

