    -- ============ HUD chico (punto de estado, título, subtítulo y botones) ============
    -- o = {Name, Buttons = {{Key, Text, Width}}}; H:SetTitle / SetSubtitle / SetDot(color) / Button(key)
    function Kit.Hud(o)
        o = o or {}
        local gui = Kit.Screen(o.Name or "YYHud", o.DisplayOrder or 80)
        local card = Btn(gui, {AnchorPoint = Vector2.new(0.5, 0), Position = o.Position or UDim2.new(0.5, 0, 0, 58), Size = UDim2.fromOffset(o.Width or 270, 54),
            BackgroundTransparency = 0.08, Text = ""}, "Background", "Text")
        Kit.Corner(card, 14)
        local stroke = Kit.New("UIStroke", {Thickness = 1.5, Transparency = 0.2}, card)
        local dot = Kit.New("Frame", {Size = UDim2.fromOffset(10, 10), Position = UDim2.fromOffset(14, 13), BorderSizePixel = 0}, card)
        Kit.Corner(dot, 99)
        local H = {Gui = gui, Card = card, Buttons = {}}
        H.Title = Label(card, {Position = UDim2.fromOffset(32, 6), Size = UDim2.new(1, -150, 0, 22), Font = Enum.Font.GothamBlack, TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = o.Title or ""}, "Text")
        H.Subtitle = Label(card, {Position = UDim2.fromOffset(14, 28), Size = UDim2.new(1, -28, 0, 18), Font = Enum.Font.GothamMedium, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = ""}, "TextDim")
        local x = -10
        for _, b in ipairs(o.Buttons or {}) do
            local btn = Btn(card, {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, x, 0, 8), Size = UDim2.fromOffset(b.Width or 56, 22), TextSize = 11,
                Text = b.Text or ""}, "Secondary", "Text")
            Kit.Corner(btn, 11)
            H.Buttons[b.Key] = btn
            x = x - (b.Width or 56) - 6
        end
        dragFrom(card, card)
        function H:SetDot(color)
            Kit.Tween(dot, 0.25, {BackgroundColor3 = color})
            Kit.Tween(stroke, 0.25, {Color = color})
        end
        function H:Destroy() if gui.Parent then gui:Destroy() end end
        return H
    end

    -- ============ ventana anfitriona (marco + barra con título, fijar y cerrar; el contenido lo pone el script) ============
    function Kit.HostWindow(o)
        o = o or {}
        local W = Kit.Window({Name = o.Name or "YYHost", DisplayOrder = o.DisplayOrder or 90, IgnoreGuiInset = true, Width = UDim2.fromScale(0.74, 0.74),
            Height = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.53), Title = o.Title, TitleSize = 14, HeaderHeight = 34,
            Lock = true, Locked = o.Locked, OnLock = o.OnLock, Close = true, OnClose = o.OnClose, Raw = true, Radius = 16, Transparency = 0.05, Clip = true})
        -- el tamaño lo da el marco (0.74 x 0.74 de la pantalla)
        W.Frame.Size = UDim2.fromScale(0.74, 0.74)
        W.Frame.AutomaticSize = Enum.AutomaticSize.None
        W.Frame.ClipsDescendants = false
        W.Body.Size = UDim2.new(1, 0, 1, -34)
        W.Body.ClipsDescendants = true
        return W
    end

    -- ============ botón redondo de la barra de arriba (con bolsa dibujada) ============
    -- o = {Name, LayoutOrder, OnClick}; devuelve el Frame (mismos nombres internos que los botones de la barra)
    function Kit.TopbarButton(parent, o)
        o = o or {}
        local b = Kit.Make("Frame", {Name = o.Name or "YYButton", BackgroundTransparency = 1, ClipsDescendants = true, LayoutOrder = o.LayoutOrder or 996,
            Size = UDim2.fromOffset(44, 44), ZIndex = 20}, parent)
        b:SetAttribute("YYTopbar", true)
        local iconButton = Kit.Make("Frame", {Name = "IconButton", BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 0.3,
            BorderSizePixel = 0, ClipsDescendants = true, Size = UDim2.fromScale(1, 1), ZIndex = 2}, b)
        Kit.Make("UICorner", {CornerRadius = UDim.new(1, 0)}, iconButton)
        local iconImage = Kit.Make("ImageLabel", {Name = "IconImage", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromScale(0.62, 0.62), BackgroundTransparency = 1, Image = "", ImageColor3 = Color3.new(1, 1, 1), ZIndex = 15}, iconButton)
        Kit.Make("UIAspectRatioConstraint", {DominantAxis = Enum.DominantAxis.Height}, iconImage)
        local bag = Kit.Make("Frame", {AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 0.96), Size = UDim2.fromScale(0.8, 0.6),
            BackgroundTransparency = 1, ZIndex = 15}, iconImage)
        Kit.Make("UICorner", {CornerRadius = UDim.new(0.2, 0)}, bag)
        local bodyStroke = Kit.Make("UIStroke", {Thickness = 2, Color = iconImage.ImageColor3}, bag)
        local clip = Kit.Make("Frame", {AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.02), Size = UDim2.fromScale(0.46, 0.36),
            BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 15}, iconImage)
        local handle = Kit.Make("Frame", {AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 2), Size = UDim2.new(0.86, 0, 0.86 * 0.46 / 0.36, 0),
            BackgroundTransparency = 1, ZIndex = 15}, clip)
        Kit.Make("UICorner", {CornerRadius = UDim.new(1, 0)}, handle)
        local handleStroke = Kit.Make("UIStroke", {Thickness = 2, Color = iconImage.ImageColor3}, handle)
        local dot = Kit.Make("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.62), Size = UDim2.fromScale(0.14, 0.14),
            BackgroundColor3 = iconImage.ImageColor3, ZIndex = 15}, bag)
        Kit.Make("UICorner", {CornerRadius = UDim.new(1, 0)}, dot)
        iconImage:GetPropertyChangedSignal("ImageColor3"):Connect(function()
            local c = iconImage.ImageColor3
            bodyStroke.Color, handleStroke.Color, dot.BackgroundColor3 = c, c, c
        end)
        local ring = Kit.Make("Frame", {Name = "YYRing", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.new(1, -4, 1, -4), BackgroundTransparency = 1, ZIndex = 16}, iconButton)
