                    TweenService:Create(
                        ThumbGlow,
                        TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                        {BackgroundTransparency = 0.4}
                    ):Play()
                else
                    SliderFill.Size = targetSize
                    SliderThumb.Position = thumbTarget
                    ThumbGlow.BackgroundTransparency = 0.4
                end

