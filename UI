        if not ts then return "" end
        local d = math.max(0, os.time() - math.floor(ts))
        if d < 60 then return "ahora" end
        if d < 3600 then return math.floor(d / 60) .. " min" end
        if d < 86400 then return math.floor(d / 3600) .. " h" end
