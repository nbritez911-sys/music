        return container(box, o.Gap or 6)
    end
    -- fila "nombre ........ valor" (devuelve el valor)
    function Widgets:Row(name, o)
        o = o or {}
        local r = Kit.New("Frame", {LayoutOrder = self:_next(), Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1}, self.Frame)
        Label(r, {Size = UDim2.new(o.Split or 0.45, 0, 1, 0), Font = Enum.Font.GothamMedium, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left, Text = name}, "TextDim")
        return Label(r, {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(1 - (o.Split or 0.45), 0, 1, 0),
            TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd, Text = "-"}, "Text")
    end
    -- barra de progreso con textos a los costados (arriba) o abajo
    function Widgets:Progress(o)
        o = o or {}
        local wrap = Kit.New("Frame", {LayoutOrder = self:_next(), Size = UDim2.new(1, 0, 0, o.Below and 26 or 26), BackgroundTransparency = 1}, self.Frame)
        local P = {}
        if o.Below then
            local _, fill = Kit.Bar(wrap, {Size = UDim2.new(1, 0, 0, o.Thick or 8)}, "Accent", o.Track or "Background")
            P.Fill = fill
            P.Left = Label(wrap, {Position = UDim2.fromOffset(0, (o.Thick or 8) + 2), Size = UDim2.new(1, 0, 0, 14), TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Left, Text = ""}, "TextDim")
        else
            P.Left = Label(wrap, {Size = UDim2.new(0.7, 0, 0, 14), TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, Text = ""}, "Text")
            P.Right = Label(wrap, {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0.3, 0, 0, 14),
                TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right, Text = ""}, "Accent")
            local _, fill = Kit.Bar(wrap, {Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, o.Thick or 8)}, "Accent", o.Track or "Secondary")
            P.Fill = fill
        end
        if o.Gradient ~= false then
            local g = Kit.New("UIGradient", {Color = ColorSequence.new(Kit.Palette().Accent, Kit.Palette().Accent:Lerp(Color3.new(1, 1, 1), 0.45))}, P.Fill)
            local off = Kit.OnTheme(function(p) g.Color = ColorSequence.new(p.Accent, p.Accent:Lerp(Color3.new(1, 1, 1), 0.45)) end)
            wrap.Destroying:Connect(off)
        end
        function P:Set(fraction, left, right)
            if left then P.Left.Text = left end
            if right and P.Right then P.Right.Text = right end
            Kit.Tween(P.Fill, 0.4, {Size = UDim2.fromScale(math.clamp(tonumber(fraction) or 0, 0, 1), 1)}, Enum.EasingStyle.Quad)
        end
        return P
    end
    -- barra fina sola (devuelve el relleno)
    function Widgets:Bar(o)
        o = o or {}
        local _, fill = Kit.Bar(self.Frame, {LayoutOrder = self:_next(), Size = UDim2.new(1, 0, 0, o.Thick or 5)}, "Accent", o.Track or "Background")
        return fill
    end
    -- chip + texto grande a la derecha (estado / velocidad)
    function Widgets:ChipValue()
        local r = Kit.New("Frame", {LayoutOrder = self:_next(), Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1}, self.Frame)
        local chip = Kit.New("TextLabel", {Size = UDim2.fromOffset(120, 22), BorderSizePixel = 0, Font = Enum.Font.GothamBold, TextSize = 11, Text = ""},
            r, {bg = "Background", text = "Text"})
        Kit.Corner(chip, 11)
        local chipStroke = Kit.New("UIStroke", {Thickness = 1.5, Transparency = 0.1}, chip)
        local value = Label(r, {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(1, -130, 1, 0),
            Font = Enum.Font.GothamBlack, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Right, Text = "0"}, "Text")
        return chip, chipStroke, value
    end
    -- mosaicos (3 columnas): defs = {{Key, Label, Icon, Color}} ; T:Set(key, texto, delta)
    function Widgets:Tiles(defs)
        local grid = Kit.New("Frame", {LayoutOrder = self:_next(), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1}, self.Frame)
        Kit.New("UIGridLayout", {CellSize = UDim2.new(1 / 3, -6, 0, 50), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder}, grid)
        local T = {Items = {}}
        for i, d in ipairs(defs) do
            local t = Kit.New("Frame", {LayoutOrder = i, BackgroundTransparency = 0.25, BorderSizePixel = 0}, grid, {bg = "Secondary"})
            Kit.Corner(t, 12)
            Kit.New("ImageLabel", {Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1,
                Image = d.Icon or "", ImageColor3 = d.Color or Color3.new(1, 1, 1)}, t, d.Color == nil and {image = "Accent"} or nil)
            local value = Kit.New("TextLabel", {Position = UDim2.fromOffset(28, 6), Size = UDim2.new(1, -32, 0, 20), BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack, TextSize = 14, TextColor3 = d.Color or Color3.new(1, 1, 1), TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd, Text = "0"}, t, d.Color == nil and {text = "Accent"} or nil)
            Label(t, {Position = UDim2.fromOffset(8, 30), Size = UDim2.new(1, -12, 0, 14), Font = Enum.Font.GothamMedium, TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Left, Text = d.Label or ""}, "TextDim")
            local pop = Kit.New("TextLabel", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 30), Size = UDim2.fromOffset(50, 14),
                BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = Color3.fromRGB(110, 255, 140),
                TextXAlignment = Enum.TextXAlignment.Right, TextTransparency = 1, Text = ""}, t)
            T.Items[d.Key] = {Value = value, Pop = pop}
        end
        function T:Set(key, text, delta)
            local it = T.Items[key]
            if not it then return end
            it.Value.Text = text
            if delta and delta ~= "" then
                it.Pop.Text = delta
                it.Pop.TextTransparency = 0
                Kit.Tween(it.Pop, 1.6, {TextTransparency = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            end
        end
        return T
    end
    -- caja de búsqueda
    function Widgets:Search(placeholder)
        local box = Kit.New("TextBox", {LayoutOrder = self:_next(), Size = UDim2.new(1, 0, 0, 32), BorderSizePixel = 0, Text = "",
            PlaceholderText = placeholder or "", PlaceholderColor3 = Kit.Palette().TextDim, Font = Enum.Font.GothamMedium, TextSize = 13,
            ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left}, self.Frame, {bg = "Secondary", text = "Text"})
        Kit.Corner(box, 10)
        Kit.Pad(box, 0, 0, 0, 12)
        return box
    end
    -- grilla de opciones elegibles: G:Set({{Key, Text}}, elegido, alElegir)
    function Widgets:Grid(o)
        o = o or {}
        local list = Kit.New("ScrollingFrame", {LayoutOrder = self:_next(), Size = UDim2.new(1, 0, 0, o.Height or 120), BackgroundTransparency = 0.4,
            BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = Kit.Palette().Accent, CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y}, self.Frame, {bg = "Secondary"})
        Kit.Corner(list, 10)
        Kit.Pad(list, 6, 6, 6, 6)
        Kit.New("UIGridLayout", {CellSize = UDim2.new(1 / (o.Columns or 2), -4, 0, 26), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder}, list)
        local G = {Frame = list, Chips = {}}
        function G:Set(items, selected, onPick)
            for _, c in ipairs(G.Chips) do c:Destroy() end
            table.clear(G.Chips)
            for i, it in ipairs(items) do
                local on = it.Key == selected
                local b = Btn(list, {LayoutOrder = i, Font = Enum.Font.GothamMedium, TextSize = 11, Text = it.Text, TextTruncate = Enum.TextTruncate.AtEnd},
                    on and "Accent" or "Background", on and "AccentText" or "Text")
                Kit.Corner(b, 8)
                b.Activated:Connect(function() if onPick then onPick(it.Key) end end)
                G.Chips[#G.Chips + 1] = b
            end
        end
        return G
    end
    -- fila de botones: defs = {{Text, Width (0..1), Accent, OnClick}} ; devuelve los botones (con :SetOn / :SetText)
    function Widgets:Buttons(defs, o)
        o = o or {}
        local r = Kit.New("Frame", {LayoutOrder = self:_next(), Size = UDim2.new(1, 0, 0, o.Height or 32), BackgroundTransparency = 1}, self.Frame)
        Kit.List(r, 6, true)
        local out = {}
        for i, d in ipairs(defs) do
            local b = Btn(r, {LayoutOrder = i, Size = UDim2.new(d.Width or (1 / #defs), -4, 1, 0), TextSize = d.TextSize or 12, Text = d.Text or ""},
                d.Accent and "Accent" or "Secondary", d.Accent and "AccentText" or (d.Dim and "TextDim" or "Text"))
            -- color de texto propio (no sigue al tema)
            if d.TextColor then b:SetAttribute("ThemeTextRole", nil) b.TextColor3 = d.TextColor end
            Kit.Corner(b, o.Radius or 10)
            if d.OnClick then b.Activated:Connect(d.OnClick) end
            local obj = {Button = b}
            function obj:SetOn(on) onOff(b, on, d.Dim and "TextDim" or "Text") end
            function obj:SetText(t) b.Text = t end
            out[i] = obj
        end
        return out, r
    end
    -- texto + [-] valor [+]
    function Widgets:Stepper(name, onMinus, onPlus)
        local r = Kit.New("Frame", {LayoutOrder = self:_next(), Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1}, self.Frame)
        Kit.List(r, 6, true)
        Label(r, {LayoutOrder = 1, Size = UDim2.new(0.38, -6, 1, 0), Font = Enum.Font.GothamMedium, TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left, Text = name}, "Text")
